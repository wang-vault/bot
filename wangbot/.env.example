# ===== WANGBOT CONFIGURATION =====

# Nama bot
BOT_NAME=WangBot

# Nomor owner (bisa lebih dari satu, pisahkan dengan koma).
# Format: kode negara + nomor tanpa tanda + / 0 di depan. Contoh Indonesia: 6281234567890
# (Lewat command .addowner / .delowner boleh pakai bentuk 0812xxxx atau +62 812-xxxx —
#  bot yang menormalkan sendiri, tidak perlu JID.)
OWNER_NUMBER=6281234567890

# Prefix command. Bisa beberapa karakter sekaligus.
PREFIX=.

# Kata sandi untuk beberapa fitur sensitif (opsional)
BOT_PASSWORD=

# ===== KONTAK & LAYANAN =====
# Ganti semua nilai di bawah sesuai data WangStore Anda
WANGSTORE_WEBSITE=https://wangstore.id
WANGSTORE_PANEL=https://panel.wangstore.id
COMMUNITY_GROUP=https://chat.whatsapp.com/xxxxxxxxxxxxxxxx
ADMIN_CONTACT=6281234567890
WHATSAPP_ADMIN=6281234567890
TELEGRAM_ADMIN=
INSTAGRAM_ADMIN=

# Jam operasional (format 24 jam)
OPERATIONAL_HOURS=08:00-22:00

# ===== PTERODACTYL PANEL API (untuk monitoring hosting) =====
# PENTING: gunakan APPLICATION API KEY, bukan Client API.
#   Cara: Admin panel -> Application API -> buat key baru,
#   centang permission: Locations, Nodes, Servers (Read).
#   Copy SELURUH string key ke bawah.
PANEL_API_URL=https://panel.wangstore.id
PANEL_API_TOKEN=

# Grup/notif tujuan alert monitoring (kosongkan untuk kirim ke owner)
MONITOR_NOTIFY=

# ===== MONITORING OTOMATIS =====
# Interval cek monitoring (menit)
MONITOR_INTERVAL=5
# Threshold alert (persen)
ALERT_RAM_THRESHOLD=90
ALERT_CPU_THRESHOLD=90
ALERT_DISK_THRESHOLD=90

# ===== MONITORING SERVER MINECRAFT =====
# Butuh CLIENT API key (panel -> klik foto profil -> API Credentials),
# berbeda dengan PANEL_API_TOKEN di atas yang memakai Application API key.
# Client key hanya bisa melihat server milik akun itu sendiri, jadi aman
# dipakai untuk memantau server pelanggan.
PANEL_CLIENT_TOKEN=

# 0 = matikan pemantauan server Minecraft
MC_MONITOR=1
# Interval cek server MC (menit) — lebih rapat dari monitoring node
MC_MONITOR_INTERVAL=2
# Threshold alert resource server MC (persen)
MC_ALERT_RAM_THRESHOLD=90
MC_ALERT_CPU_THRESHOLD=90
# Selang pengingat selama server masih down (menit)
MC_DOWN_REMIND_MINUTES=30
# Batas server yang boleh dipantau satu nomor WhatsApp
MC_MAX_SERVERS_PER_USER=5
# Timeout ping ke server Minecraft (ms)
MC_PING_TIMEOUT=5000
# Kirim juga ringkasan down/online ke admin? (1 = ya)
MC_NOTIFY_ADMIN=1
# Izinkan console/power command dipakai di grup? (default 0 = hanya chat pribadi)
MC_CONSOLE_IN_GROUP=0

# ===== PING LUAR (.pingl) =====
# Owner + daftar staf boleh menguji koneksi keluar dari server bot:
#   .pingl 8.8.8.8 | .pingl google.com 8 | .pingl mc.customer.id:25565
# Staf tambahan (pisahkan koma) — juga bisa dikelola tanpa restart lewat
#   .pingl staff add <nomor>
PINGL_STAFF=
# Jumlah paket default dan maksimum per tes (1-15)
PING_COUNT=4
PING_MAX_COUNT=15
# Timeout per paket (detik, 1-8)
PING_TIMEOUT=2
# Jalur binary ping kalau bukan yang ada di PATH (mis. /bin/ping di container)
# PING_BIN=/usr/bin/ping

# ===== ASK AI (fitur .ai) =====
# Bot tidak dikunci ke satu vendor: isi 3 nilai wajib di bawah sesuai penyedia
# AI yang kamu pakai. Semua bisa juga diisi dari WhatsApp (tanpa restart) lewat
#   .aiset api <url> | .aiset key <apikey> | .aiset model <nama-model>
# Nilai yang di-set lewat .aiset disimpan di data/database.json dan MENANG atas
# nilai .env ini. Resep lengkap per penyedia: docs/AI.md
#
# Contoh OpenAI        : AI_API_URL=https://api.openai.com/v1              AI_MODEL=gpt-4o-mini
# Contoh Groq          : AI_API_URL=https://api.groq.com/openai/v1         AI_MODEL=llama-3.3-70b-versatile
# Contoh OpenRouter    : AI_API_URL=https://openrouter.ai/api/v1           AI_MODEL=openai/gpt-4o-mini
# Contoh Google Gemini : AI_API_URL=https://generativelanguage.googleapis.com/v1beta  AI_MODEL=gemini-2.0-flash
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Gaya API: openai | gemini | auto (default auto = ditebak dari URL)
AI_PROVIDER=auto

# Opsional — kosongkan untuk pakai nilai bawaan
# AI_SYSTEM_PROMPT=Kamu adalah asisten AI WangStore. Jawab singkat dalam Bahasa Indonesia.
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=700
# AI_TIMEOUT=30            # detik
# AI_HISTORY=6             # pesan riwayat yang dibawa (0 = tanpa memori)
# AI_MAX_CHARS=1500        # panjang pertanyaan maksimum
# AI_ENABLED=1             # 0 = matikan fitur .ai
# AI_ALLOW_GROUP=1         # 0 = .ai hanya bisa di chat pribadi
# Header tambahan (JSON), mis. OpenRouter butuh HTTP-Referer:
# AI_EXTRA_HEADERS={"HTTP-Referer":"https://wangstore.id","X-Title":"WangBot"}

# ===== PERSONAL AGENT (kepribadian + otonomi + penjaga kode) =====
# Agent memakai provider AI yang sama dengan fitur .ai di atas.
ASSISTANT_ENABLED=1
# chat        = hanya bicara
# supervised  = semua command menunggu .approve
# safe        = command baca-saja otomatis; perubahan menunggu .approve (disarankan)
# autonomous  = baca + operasi ringan otomatis; tindakan sensitif tetap menunggu .approve
ASSISTANT_MODE=safe
# 1 = pesan biasa owner di private chat langsung ditangani agent tanpa .asisten
ASSISTANT_AUTO_CHAT=0
# Batas tindakan dalam satu rencana dan masa berlaku approval
ASSISTANT_MAX_ACTIONS=3
ASSISTANT_APPROVAL_MINUTES=10

# Kepribadian (semua bisa diubah tanpa restart lewat .persona)
ASSISTANT_NAME=
ASSISTANT_OWNER_NAME=Owner
ASSISTANT_ROLE=asisten pribadi owner sekaligus penjaga operasional WangStore
ASSISTANT_TRAITS=proaktif, tenang, jujur, teliti, loyal, dan berani mengingatkan jika ada risiko
ASSISTANT_STYLE=Bahasa Indonesia yang natural, hangat, ringkas, dan tidak kaku

# Self-check source otomatis + laporan ke seluruh owner
ASSISTANT_GUARDIAN=1
ASSISTANT_CHECK_INTERVAL=360
ASSISTANT_REPORT_RUNTIME_ERRORS=1
# 1 = kirim laporan rutin walau sehat; 0 = hanya saat ada masalah/perubahan
ASSISTANT_REPORT_HEALTHY=0
ASSISTANT_REPORT_REPEAT_HOURS=24
# Peringatkan bila RSS proses melewati nilai ini
ASSISTANT_MEMORY_WARN_MB=350

# ===== AKSES GRUP UNTUK AGENT & ASK AI =====
# Agent bisa dihubungi dari grup, tetapi HANYA dari grup yang didaftarkan owner
# lewat `.groupaccess add <jid>` (lihat juga `.groupaccess listgrup` untuk
# melihat JID grup yang bot ikuti). Pengaturan di bawah = nilai default;
# semuanya bisa diubah tanpa restart lewat command `.groupaccess`.
#
# 1 = agent & Ask AI boleh dipakai di grup (default). 0 = bungkam total di
#     semua grup; hanya chat pribadi yang jalan.
GROUP_ACCESS_ENABLED=1
# 1 = hanya grup yang masuk allowlist owner (default). 0 = semua grup boleh
#     (perilaku lama), batas role & saklar fitur tetap berlaku.
GROUP_ACCESS_ENFORCE=1
GROUP_AGENT_IN_GROUP=1
GROUP_AI_IN_GROUP=1
# Batas role minimal memakai agent/AI di sebuah grup:
#   owner  = hanya owner bot
#   admin  = owner + admin grup  (default, paling aman untuk grup pelanggan)
#   member = semua peserta grup
#   all    = siapa pun di grup itu (termasuk yang bukan peserta)
GROUP_ACCESS_ROLE=admin
# Seberapa jauh agent boleh bertindak di grup:
#   none = hanya bicara, tidak pernah menjalankan command
#   read = hanya command baca-saja; tindakan lain jadi proposal ke owner (default)
#   full = seperti mode otonomi global, tapi write/sensitif tetap butuh .approve owner
GROUP_AGENT_TOOLS=read
# Ke mana jawaban dikirim:
#   smart   = obrolan -> grup; server/hosting -> DM owner; admin -> DM admin grup (default)
#   group   = semua jawaban tampil di grup
#   private = semua jawaban ke DM owner
#   admin   = semua jawaban ke DM admin grup
GROUP_AGENT_ROUTE=smart
# 1 = agent menjawab pesan tanpa prefix di grup, tetapi hanya bila bot di-tag
GROUP_AGENT_MENTION=1
GROUP_AGENT_AUTOREPLY=0
# Bootstrap allowlist saat start (pisahkan koma). Harus JID grup, mis.
# 120363012345678901@g.us — bukan link undangan.
GROUP_ACCESS_ALLOW=

# ===== LOGGING =====
# silent = log Baileys disembunyikan (bersih). Untuk debugging: warn / debug.
LOG_LEVEL=silent

# Versi WhatsApp Web protocol (opsional). Kosongkan = ambil otomatis.
# WA_VERSION=2.3000.1043857760
WA_VERSION=

# ===== DATABASE =====
DB_PATH=./data/database.json
AUTH_PATH=./data/auth
