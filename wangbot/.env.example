# ===== WANGBOT CONFIGURATION =====

# Nama bot
BOT_NAME=WangBot

# Nomor owner (bisa lebih dari satu, pisahkan dengan koma).
# Format: kode negara + nomor tanpa tanda + / 0 di depan. Contoh Indonesia: 6281234567890
OWNER_NUMBER=6281234567890

# Prefix command. Bisa beberapa karakter sekaligus.
PREFIX=.

# Kata sandi untuk beberapa fitur sensitif (opsional)
BOT_PASSWORD=

# ===== KONTAK & LAYANAN =====
# Ganti semua nilai di bawah sesuai data WangStore Anda
WANGSTORE_WEBSITE=https://wangstore.id
WANGSTORE_PANEL=https://panel.wangstore.id
COMMUNITY_GROUP=https://chat.whatsapp.com/xxxxxxxxxxxxxxxx
ADMIN_CONTACT=6281234567890
WHATSAPP_ADMIN=6281234567890
TELEGRAM_ADMIN=
INSTAGRAM_ADMIN=

# Jam operasional (format 24 jam)
OPERATIONAL_HOURS=08:00-22:00

# ===== PTERODACTYL PANEL API (untuk monitoring hosting) =====
# PENTING: gunakan APPLICATION API KEY, bukan Client API.
#   Cara: Admin panel -> Application API -> buat key baru,
#   centang permission: Locations, Nodes, Servers (Read).
#   Copy SELURUH string key ke bawah.
PANEL_API_URL=https://panel.wangstore.id
PANEL_API_TOKEN=

# Grup/notif tujuan alert monitoring (kosongkan untuk kirim ke owner)
MONITOR_NOTIFY=

# ===== MONITORING OTOMATIS =====
# Interval cek monitoring (menit)
MONITOR_INTERVAL=5
# Threshold alert (persen)
ALERT_RAM_THRESHOLD=90
ALERT_CPU_THRESHOLD=90
ALERT_DISK_THRESHOLD=90

# ===== LOGGING =====
# silent = log Baileys disembunyikan (bersih). Untuk debugging: warn / debug.
LOG_LEVEL=silent

# Versi WhatsApp Web protocol (opsional). Kosongkan = ambil otomatis.
# WA_VERSION=2.3000.1043857760
WA_VERSION=

# ===== DATABASE =====
DB_PATH=./data/database.json
AUTH_PATH=./data/auth
